# Скопируйте в .env и заполните. Файл .env в git НЕ коммитится.
# Сгенерировать случайные значения: python scripts/gen_env.py > .env

# Публичный адрес вики (без слэша в конце).
# Локально: http://localhost:8080, на сервере: https://wiki.inbicst.ru
MW_SERVER=http://localhost:8080

# На каком адресе/порту хоста слушает контейнер MediaWiki.
# 127.0.0.1 — доступно только с этой машины (на сервере наружу смотрит reverse proxy).
MW_BIND_ADDR=127.0.0.1
MW_HTTP_PORT=8080

# База данных
MW_DB_NAME=wiki
MW_DB_USER=wiki
MW_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

# Ключи MediaWiki ($wgSecretKey — 64 hex-символа, $wgUpgradeKey — 16 hex-символов)
MW_SECRET_KEY=change-me
MW_UPGRADE_KEY=change-me

# Первый администратор. Используется только скриптом scripts/install.sh при первичной установке.
MW_ADMIN_USER=Admin
MW_ADMIN_PASSWORD=change-me
